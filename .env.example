# Copy to .env.local for local development. Never commit real values.

# Base URL of proba-hub.
VITE_API_BASE_URL=http://localhost:3000

# Path of the Hub sign-in endpoint (POST { email, password }).
VITE_AUTH_LOGIN_PATH=/v1/auth/login

# Development only: run the UI against built-in demo data instead of the Hub.
# Off by default. It is compiled out of builds where it is not "true".
VITE_DEMO_MODE=false
