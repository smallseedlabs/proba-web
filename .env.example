# Copy to .env.local for local development. Never commit real values.

# Base URL of proba-hub.
VITE_API_BASE_URL=http://localhost:3000

# Base URL of the audit API (proba-audit). Source of the campaign charts; leave empty to
# show charts as unavailable. The audit API must list this app's origin in AUDIT_API_CORS_ORIGINS.
VITE_AUDIT_API_BASE_URL=

# Firebase Authentication web app config (Firebase console > Project settings >
# General > Your apps > Web app). These identify the project to the browser and
# are not secrets, but keep real values in .env.local, not in the repository.
# Sign-in shows "temporarily unavailable" until all four are set.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=

# Development only: run the UI against built-in demo data instead of the Hub.
# Off by default. It is compiled out of builds where it is not "true".
VITE_DEMO_MODE=false
